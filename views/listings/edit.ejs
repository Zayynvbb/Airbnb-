<% layout('layouts/boilerplate') %>

<body>
  
<div class="row mt-3 edit-listing">
  <div class="col-8 offset-2">
    <h3>Edit your Listing</h3>
  <form method="POST" action="/listings/<%=listing._id%>?_method=PUT" class="needs-validation" novalidate enctype="multipart/form-data">

    <div class="mb-3">
    <label for="title">Title:</label>
    <input type="text" value="<%=listing.title%>" id="title" class="form-control" name="listing[title]" required>
    <div class="invalid-feedback">Title is required!</div>
    </div>

    <div class="mb-3">Original Image:<br>
      <img src="<%= originalImageUrl %>" alt="Listing Image" class="img-thumbnail" style="max-width: 200px;">
    </div>

    <div class="mb-3">
      <label for="image">Upload new image</label>
      <input type="file" id="image" class="form-control" name="listing[image][url]" required>

    </div>
    <div class="mb-3">
      
    <label for="description">Description:</label><br>
    <textarea id="description" name="listing[description]" rows="4" cols="50" required class="form-control"><%=listing.description%></textarea>
    <div class="invalid-feedback">Description is required!</div>
    </div>

    <div class="row">
      <div class="mb-3 col-md-4">
        <label for="price">Price (in INR):</label>
        <input type="number" value="<%=listing.price%>" id="price" class="form-control"   name="listing[price]" required>
        <div class="invalid-feedback">Price is required!</div>
      </div>
    
      <div class="mb-3 col-md-8">
      
        <label for="country">Country:</label>
        <input type="text" value="<%=listing.country%>" id="country" class="form-control" name="listing[country]" required>
        <div class="invalid-feedback">Country is required!</div>
      </div><br><br>
    </div>


    <div class="mb-3">
      
    <label for="location">Location:</label>
    <input type="text" value="<%=listing.location%>" id="location" class="form-control" name="listing[location]" required>
    <div class="invalid-feedback">Location is required!</div>
    </div>
    

    <button type="submit" class="btn mt-3 btn-dark edit-btn">Edit</button> <br><br><br>

  </form>
  
</div>
</body>
</html>