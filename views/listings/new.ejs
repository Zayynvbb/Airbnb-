<% layout('layouts/boilerplate') %>
<body>
  <div class="row mt-3">
    <div class="col-8 offset-2">
      
  <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
    <h3>Create New Listing</h3><br><Br>
    <div class="mb-3">
      <label for="title" class="form-label">Title:</label>
    <input 
      placeholder="Enter listing title" 
      type="text" 
      id="title" 
      name="listing[title]" 
      required
      class="form-control"/>
      <div class="valid-feedback">Title Looks Good!</div>
      <div class="invalid-feedback">Title is required!</div>
    </div>

    <!-- <div class="mb-3">
    <label for="image" class="form-label">Image URL:</label>
    <input placeholder="Enter image URL" type="url" id="image" name="listing[image][url]" class="form-control">
    </div> -->

    
    <div class="mb-3">
    <label for="image" class="form-label">Upload Image</label>
    <input placeholder="Upload image " type="file" id="image" name="listing[image]" class="form-control">required
    </div>
    
    <div class="mb-3">
      <label for="description" class="form-label">Description:</label><br>
    <textarea 
    placeholder="Enter listing description" id="description" 
    name="listing[description]" 
    rows="4" cols="50" 
    required 
    class="form-control"></textarea>
    <div class="invalid-feedback">Description is required!</div>
    </div>
    
    <div class="row">
      
    <div class="mb-3 col-md-4">
      <label for="price" class="form-label">Price (in INR):</label>
    <input placeholder="Enter price"  id="price" name="listing[price]" required class="form-control">
    <div class="invalid-feedback">Price is required!</div>
    </div>
    <div class="mb-3 col-md-8">
      <label for="country" class="form-label">Country:</label>
      <input placeholder="Enter country" type="text" id="country" name="listing[country]" required class="form-control">
      <div class="invalid-feedback">Country is required!</div>
    </div><br><br>

    </div>

    <div class="mb-3">
      <label for="location" class="form-label">Location:</label>
      <input placeholder="Enter location" type="text" id="location" name="listing[location]" required class="form-control">
      <div class="invalid-feedback">Location is required!</div>
    </div>
    <vbr><br>

    <button class="btn mt-3 btn-dark add-btn" type="submit">Add</button>
    <br><br>

  </form>

    </div>

  </div>



